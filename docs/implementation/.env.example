# =============================================================================
# ContractIQ — environment variables
# Copy this file to the project root as `.env.example`, then copy that to
# `.env.local` and fill in the values. Never commit `.env.local`.
# Variables NOT prefixed with NEXT_PUBLIC_ are server-only and must never be
# imported into a Client Component — a CI job greps the built client bundle for
# the names marked "SERVER ONLY" and fails the build on a hit.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=            # Project URL — Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # anon / publishable key — Settings > API. Safe in the browser; RLS constrains it.
SUPABASE_SERVICE_ROLE_KEY=           # SERVER ONLY — service_role key, Settings > API. Bypasses RLS. Used only by the call sites in spec 13 §2 (+ v1.1 §C): DELETE /api/account, the Edge Functions, the rate-limit/quota/slot RPCs, the CRM OAuth callback write, and the operator/eval scripts under scripts/ and eval/ — never anywhere else in src/.
SUPABASE_PROJECT_REF=                # SERVER ONLY — project ref (the subdomain in the project URL). Used by scripts and the cron job URL.
SUPABASE_DB_URL=                     # SERVER ONLY — Postgres connection string, Settings > Database. Used by local integration/RLS tests only.

# -----------------------------------------------------------------------------
# OpenAI  (the only inference provider — GPT-4o for extraction, summary and chat)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=                      # SERVER ONLY — platform.openai.com > API keys. Never reaches the browser.
OPENAI_MODEL=gpt-4o                  # Fallback model id when a per-purpose OPENAI_MODEL_* below is unset (v1.1)
OPENAI_TIMEOUT_MS=20000              # Per-call timeout for chat and the query enhancer (PRD §5: ≤ 20 s P95)
OPENAI_EXTRACTION_TIMEOUT_MS=45000   # L5 (Stage 5d-1): extraction + JSON repair; a 36-term MSA batch runs 14–16 s. Capped by the caller's deadline on the inline path.
OPENAI_MAX_RETRIES=3                 # Attempts with exponential backoff + jitter (1s/2s/4s)
OPENAI_EXTRACTION_MAX_TOKENS=4000    # v1.1 D47 c: per parallel extraction batch (spec 06 v1.1 §G)
OPENAI_CHAT_MAX_TOKENS=1000          # Output cap for chat answers
OPENAI_EXTRACTION_TEMPERATURE=0.1    # Deterministic structured extraction
OPENAI_CHAT_TEMPERATURE=0.4          # Slightly warmer for natural chat
OPENAI_INPUT_COST_PER_1K=0.005       # USD per 1k input tokens — used to compute openai_calls.cost_usd
OPENAI_OUTPUT_COST_PER_1K=0.015      # USD per 1k output tokens
OPENAI_MONTHLY_BUDGET_USD=300        # SERVER ONLY — daily rollup alerts at 80% of this
PROMPT_VERSION=v2.0                  # Stamped onto contracts and openai_calls rows; bump when a prompt changes. v2.0 = extraction.v2 (question-based, 36-term MSA, reasoning) — the only prompt the v1.1 build can ship

# -----------------------------------------------------------------------------
# Application limits  (PRD §5 constraints — single source of truth for both
# the client pre-checks and the authoritative server checks)
# -----------------------------------------------------------------------------
MAX_UPLOAD_MB=10                     # Hard upload size limit
MAX_PAGES=20                         # Hard page-count limit
MAX_TOKENS=15000                     # Hard contract-length limit (tiktoken o200k_base estimate)
MAX_CUSTOM_TERMS=5                   # Custom key terms per contract
MIN_TEXT_WORDS=100                   # Below this the PDF is treated as scanned -> SCANNED_PDF
SIGNED_URL_TTL_SECONDS=3600          # Storage signed-URL expiry (1 hour)
PDF_RETENTION_DAYS=90                # Days after last access before the stored PDF is purged
MAX_CHAT_HISTORY_MESSAGES=200        # Messages loaded and passed per chat turn, ascending
MAX_CHAT_HISTORY_TOKENS=8000         # History token budget; oldest-first truncation above this

# The same three limits are also exposed to the browser for the client-side
# pre-checks on /contracts/new. They are advisory only — the server re-validates.
NEXT_PUBLIC_MAX_UPLOAD_MB=10
NEXT_PUBLIC_MAX_PAGES=20
NEXT_PUBLIC_MAX_CUSTOM_TERMS=5

# -----------------------------------------------------------------------------
# Rate limiting, quota and concurrency  (engineering-doc §6.2, §8.5)
# -----------------------------------------------------------------------------
RATE_LIMIT_UPLOAD_PER_HOUR=20        # Per user
RATE_LIMIT_PROCESS_PER_HOUR=10       # Per user
RATE_LIMIT_CHAT_PER_HOUR=30          # Per user
MAX_CONCURRENT_ANALYSES=100          # Global in-flight extraction semaphore
QUOTA_FREE_TRIAL_TOTAL=5             # Analyses allowed during the 14-day trial
QUOTA_STARTER_PER_MONTH=10
QUOTA_GROWTH_PER_MONTH=40
QUOTA_PRO_PER_MONTH=0                # 0 = unlimited
TRIAL_DAYS=14

# -----------------------------------------------------------------------------
# Feature flags  (operator-set; no payment provider at MVP — Appendix A, A-06)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_EMAIL_CONFIRMATION_ENABLED=false   # Mirrors the Supabase "Confirm email" toggle (A-05: OFF at MVP)
NEXT_PUBLIC_EXPORT_ENABLED=false               # v1.1 export routes and button
CALIBRATION_WARNING_ACTIVE=false               # SERVER ONLY — set true when monthly calibration error ≥ 0.15; renders CalibrationNotice

# -----------------------------------------------------------------------------
# Netlify / deployment
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000     # Canonical origin; used for auth redirect URLs and absolute links
COMMIT_SHA=                                    # Injected by Netlify as COMMIT_REF; surfaced by GET /api/health

# -----------------------------------------------------------------------------
# Email (SMTP) — used by the send-notification Edge Function for the
# account-deletion confirmation and P0 incident emails. Same credentials as the
# Supabase Auth SMTP settings; no additional vendor.
# -----------------------------------------------------------------------------
SMTP_HOST=                           # SERVER ONLY — SMTP server hostname
SMTP_PORT=587                        # SERVER ONLY — 587 (STARTTLS) or 465 (TLS)
SMTP_USER=                           # SERVER ONLY — SMTP username
SMTP_PASSWORD=                       # SERVER ONLY — SMTP password / app key
SMTP_FROM=ContractIQ <no-reply@contractiq.app>   # SERVER ONLY — From header

# -----------------------------------------------------------------------------
# Monitoring / alerting
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STATUS_PAGE_URL=         # Uptime Robot public status page URL — linked from the footer and the incident banner
SLACK_ALERT_WEBHOOK_URL=             # SERVER ONLY — incoming webhook for cost, storage and correction-rate alerts
UPTIME_ROBOT_HEALTH_PATH=/api/health # Endpoint polled by Uptime Robot for the 99.5% uptime SLA

# =============================================================================
# v1.1 additions (PRD v1.1, 2026-09-21) — placeholders, per-purpose models,
# integrations (all NullAdapter until set), eval/judge, observability, rollout
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI — per-purpose model ids (R-31). OpenAI remains the sole provider.
# -----------------------------------------------------------------------------
OPENAI_MODEL_EXTRACTION=gpt-4o       # model.extraction — key-term extraction (36-term MSA needs OPENAI_EXTRACTION_MAX_TOKENS=3000)
OPENAI_MODEL_CHAT=gpt-4o             # model.chat
OPENAI_MODEL_SUMMARY=gpt-4o          # model.summary — US-015; a cheaper model is a candidate once the eval shows no loss
OPENAI_MODEL_ENHANCER=gpt-4o         # query-enhancement step (chat, contract-class questions only); cheaper-model candidate
OPENAI_MODEL_JUDGE=                  # SERVER ONLY — model.judge for eval/runners/hhh-judge.ts; must be a stronger model than the product models and is never used in a product prompt. Empty => judge runners emit SKIPPED.
OPENAI_SUMMARY_MAX_TOKENS=500        # D45: full-contract input, ~$0.05 per summary
OPENAI_SUMMARY_TEMPERATURE=0.2
OPENAI_SUMMARY_TIMEOUT_MS=20000      # L4 (Stage 5d-0): full-contract input; capped by the caller's deadline (route 34: 22 s)
OPENAI_ENHANCER_MAX_TOKENS=120
OPENAI_ENHANCER_TIMEOUT_MS=5000
SUMMARY_CONTEXT_TOKENS=3000          # contract-text window sent to the summariser (holds the <= $0.03 budget)
RATE_LIMIT_RISKS_PER_HOUR=10         # POST /api/contracts/{id}/risks once risk.flag is built

# -----------------------------------------------------------------------------
# Retrieval strategy (PRD §7) — full_context is the built mode
# -----------------------------------------------------------------------------
RETRIEVAL_STRATEGY=full_context      # full_context | n8n  (vector/graph are stub/planned and cannot be selected)
N8N_RAG_WEBHOOK_URL=                 # SERVER ONLY — retrieval.n8n external backend; empty => 501 NOT_IMPLEMENTED when selected
N8N_RAG_TOKEN=                       # SERVER ONLY — bearer token sent to the n8n webhook

# -----------------------------------------------------------------------------
# Integrations (P-2) — every adapter is a NullAdapter (NOT_CONFIGURED) until set
# -----------------------------------------------------------------------------
CRM_HUBSPOT_CLIENT_ID=               # crm.hubspot (US-016) — the app's OAuth client; user tokens live in Vault, never in env. One vendor at a time: leave the other pair empty.
CRM_HUBSPOT_CLIENT_SECRET=           # SERVER ONLY
CRM_SALESFORCE_CLIENT_ID=            # crm.salesforce — second vendor, after HubSpot
CRM_SALESFORCE_CLIENT_SECRET=        # SERVER ONLY
OCR_PROVIDER=                        # textract | document_ai — ingest.ocr (v1.2)
OCR_API_KEY=                         # SERVER ONLY
OCR_REGION=                          # vendor region, e.g. us-east-1
OCR_MIN_CONFIDENCE=80                # below this the upload is rejected with OCR_LOW_CONFIDENCE (prompt re-upload)
DOCX_INGEST_ENABLED=false            # ingest.docx (v1.1) — 'true' once the library extractor is written; today .docx => 422 UNSUPPORTED_FORMAT
ESIGN_PROVIDER=                      # docusign — esign.docusign (GA)
ESIGN_WEBHOOK_SECRET=                # SERVER ONLY — HMAC secret for POST /api/webhooks/esign

# -----------------------------------------------------------------------------
# Evaluation, HHH and judge (PRD §10)
# -----------------------------------------------------------------------------
HHH_MIN_HUMAN_ROWS=50                # judge runners SKIPPED until this many human hhh_scores rows exist
HHH_WEEKLY_SAMPLE_TARGET=200         # >= 200 scored samples/week per launch stage (R-20)
HHH_HUMAN_SHARE_PCT=20               # share of weekly samples scored by humans (R-27)
JUDGE_GATE_MIN=0.70                  # judge precision AND recall gate before judge verdicts count (R-26)

# -----------------------------------------------------------------------------
# Observability and alerts (PRD §11) — alert_rules delivery targets
# -----------------------------------------------------------------------------
ALERT_EMAIL_TO=                      # SERVER ONLY — recipient for alert_rules rows with channel=email (via send-notification `alert_fired`)

# -----------------------------------------------------------------------------
# Rollout cohorts (PRD §5 sampling; rollout.cohorts stub)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ROLLOUT_STAGE=internal   # internal | measurement | beta | ga — the current launch stage; users are selected by profiles.rollout_cohort

# -----------------------------------------------------------------------------
# Eval account (spec 22 §8) — the dedicated user the golden set is ingested under
# -----------------------------------------------------------------------------
EVAL_USER_EMAIL=                     # SERVER ONLY — email of the dedicated eval account (created once by an operator)
EVAL_USER_PASSWORD=                  # SERVER ONLY — its password; eval/scripts/ingest-golden-set.ts signs in with the anon key
OPERATOR_USER_ID=                    # SERVER ONLY — the operator's auth user id, stamped as created_by on SME hhh_scores rows written by eval/export/hhh-sheet.ts --import
