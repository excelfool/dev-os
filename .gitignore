# Local agent memory
.claude/agent-memory/

# Dependencies
node_modules/

# Next.js build output — .next-test and .next-e2e are the isolated build
# directories the integration and E2E harnesses compile into (NEXT_DIST_DIR).
.next/
.next-test/
.next-e2e/
*.tsbuildinfo

# Secrets. .env.local holds the Supabase service-role key and the OpenAI key.
.env
.env.local
.env*.local

# Test artefacts
test-results/
playwright-report/
blob-report/
playwright/.cache/

# OS
.DS_Store
.DS_Store

# Eval extraction cache — billed model output, regenerated by `npm run eval`.
nextjs-app/eval/reports/.cache/

# Netlify CLI link/build state — local only.
nextjs-app/.netlify/

# Emitted by Netlify's edge-function bundler during `netlify build` — local only.
nextjs-app/deno.lock
