{
  "name": "contractiq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/write-build-info.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "supabase:start": "supabase start -x realtime,imgproxy,edge-runtime,logflare,vector,supavisor,mailpit",
    "supabase:reset": "supabase db reset && docker exec -i supabase_db_contractiq-local psql -U postgres -d postgres -v ON_ERROR_STOP=1 < ../docs/implementation/supabase-schema.sql",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_REF > src/types/database.types.ts",
    "scan:secrets": "node scripts/scan-client-bundle.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/ai",
    "test:hooks": "vitest run tests/hooks",
    "test:rls": "vitest run tests/rls",
    "test:integration": "vitest run tests/integration",
    "eval": "tsx --tsconfig eval/tsconfig.json eval/runners/run-all.ts",
    "eval:sync-refs": "node scripts/sync-refs.mjs",
    "eval:offline": "tsx --tsconfig eval/tsconfig.json eval/runners/run-all.ts --offline"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.103.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^1.47.0",
    "next": "14.2.5",
    "openai": "^7.20.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.88.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.0.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "jsdom": "25.0.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "tsx": "4.19.2",
    "typescript": "^5",
    "vitest": "^2.1.9",
    "ws": "^8.21.3"
  }
}
