# =============================================================================
# ContractIQ — environment variables
# Copy this file to the project root as `.env.example`, then copy that to
# `.env.local` and fill in the values. Never commit `.env.local`.
# Variables NOT prefixed with NEXT_PUBLIC_ are server-only and must never be
# imported into a Client Component — a CI job greps the built client bundle for
# the names marked "SERVER ONLY" and fails the build on a hit.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=            # Project URL — Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # anon / publishable key — Settings > API. Safe in the browser; RLS constrains it.
SUPABASE_SERVICE_ROLE_KEY=           # SERVER ONLY — service_role key, Settings > API. Bypasses RLS. Used only by DELETE /api/account, the retention and send-notification Edge Functions, and the rate-limit/analysis-slot RPCs.
SUPABASE_PROJECT_REF=                # SERVER ONLY — project ref (the subdomain in the project URL). Used by scripts and the cron job URL.
SUPABASE_DB_URL=                     # SERVER ONLY — Postgres connection string, Settings > Database. Used by local integration/RLS tests only.

# -----------------------------------------------------------------------------
# OpenAI  (the only inference provider — GPT-4o for extraction and chat)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=                      # SERVER ONLY — platform.openai.com > API keys. Never reaches the browser.
OPENAI_MODEL=gpt-4o                  # Model id used for both extraction and chat
# OPENAI_BASE_URL=                   # SERVER ONLY — leave unset in every real environment.
                                     # Only the integration suite sets it, to point the SDK at a
                                     # local stub so tests never bill a real call.
OPENAI_TIMEOUT_MS=20000              # Per-call timeout (PRD §5: ≤ 20 s P95 per OpenAI call)
OPENAI_MAX_RETRIES=3                 # Attempts with exponential backoff + jitter (1s/2s/4s)
OPENAI_EXTRACTION_MAX_TOKENS=2000    # Output cap for key-term extraction
OPENAI_CHAT_MAX_TOKENS=1000          # Output cap for chat answers
OPENAI_EXTRACTION_TEMPERATURE=0.1    # Deterministic structured extraction
OPENAI_CHAT_TEMPERATURE=0.4          # Slightly warmer for natural chat
OPENAI_INPUT_COST_PER_1K=0.005       # USD per 1k input tokens — used to compute openai_calls.cost_usd
OPENAI_OUTPUT_COST_PER_1K=0.015      # USD per 1k output tokens
OPENAI_MONTHLY_BUDGET_USD=300        # SERVER ONLY — daily rollup alerts at 80% of this
PROMPT_VERSION=v1.0                  # Stamped onto contracts and openai_calls rows; bump when a prompt changes

# -----------------------------------------------------------------------------
# Application limits  (PRD §5 constraints — single source of truth for both
# the client pre-checks and the authoritative server checks)
# -----------------------------------------------------------------------------
MAX_UPLOAD_MB=10                     # Hard upload size limit
MAX_PAGES=20                         # Hard page-count limit
MAX_TOKENS=15000                     # Hard contract-length limit (tiktoken o200k_base estimate)
MAX_CUSTOM_TERMS=5                   # Custom key terms per contract
MIN_TEXT_WORDS=100                   # Below this the PDF is treated as scanned -> SCANNED_PDF
SIGNED_URL_TTL_SECONDS=3600          # Storage signed-URL expiry (1 hour)
PDF_RETENTION_DAYS=90                # Days after last access before the stored PDF is purged
MAX_CHAT_HISTORY_MESSAGES=200        # Messages loaded and passed per chat turn, ascending
MAX_CHAT_HISTORY_TOKENS=8000         # History token budget; oldest-first truncation above this

# The same three limits are also exposed to the browser for the client-side
# pre-checks on /contracts/new. They are advisory only — the server re-validates.
NEXT_PUBLIC_MAX_UPLOAD_MB=10
NEXT_PUBLIC_MAX_PAGES=20
NEXT_PUBLIC_MAX_CUSTOM_TERMS=5

# -----------------------------------------------------------------------------
# Rate limiting, quota and concurrency  (engineering-doc §6.2, §8.5)
# -----------------------------------------------------------------------------
RATE_LIMIT_UPLOAD_PER_HOUR=20        # Per user
RATE_LIMIT_PROCESS_PER_HOUR=10       # Per user
RATE_LIMIT_CHAT_PER_HOUR=30          # Per user
MAX_CONCURRENT_ANALYSES=100          # Global in-flight extraction semaphore
QUOTA_FREE_TRIAL_TOTAL=5             # Analyses allowed during the 14-day trial
QUOTA_STARTER_PER_MONTH=10
QUOTA_GROWTH_PER_MONTH=40
QUOTA_PRO_PER_MONTH=0                # 0 = unlimited
TRIAL_DAYS=14

# -----------------------------------------------------------------------------
# Feature flags  (operator-set; no payment provider at MVP — Appendix A, A-06)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_EMAIL_CONFIRMATION_ENABLED=false   # Mirrors the Supabase "Confirm email" toggle (A-05: OFF at MVP)
NEXT_PUBLIC_EXPORT_ENABLED=false               # v1.1 export routes and button
CALIBRATION_WARNING_ACTIVE=false               # SERVER ONLY — set true when monthly calibration error ≥ 0.15; renders CalibrationNotice

# -----------------------------------------------------------------------------
# Netlify / deployment
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000     # Canonical origin; used for auth redirect URLs and absolute links
# --- Background processing (spec 06 v1.1 §G, D49 a) ---
PROCESS_JOB_SECRET=                  # SERVER ONLY — any long random string (e.g. `openssl rand -hex 32`). Set in Netlify to turn on pipeline.async: POST /process returns 202 and the process-background function runs the pipeline. Leave unset locally and in tests: the route then runs inline.
# PROCESS_JOB_URL=                   # Tests only — where the signed job is posted; unset ⇒ the site's own /.netlify/functions/process-background
# PROCESS_JOB_BUDGET_MS=120000       # The background function's internal deadline
COMMIT_SHA=                                    # Injected by Netlify as COMMIT_REF; surfaced by GET /api/health

# -----------------------------------------------------------------------------
# Email (SMTP) — used by the send-notification Edge Function for the
# account-deletion confirmation and P0 incident emails. Same credentials as the
# Supabase Auth SMTP settings; no additional vendor.
# -----------------------------------------------------------------------------
SMTP_HOST=                           # SERVER ONLY — SMTP server hostname
SMTP_PORT=587                        # SERVER ONLY — 587 (STARTTLS) or 465 (TLS)
SMTP_USER=                           # SERVER ONLY — SMTP username
SMTP_PASSWORD=                       # SERVER ONLY — SMTP password / app key
SMTP_FROM=ContractIQ <no-reply@contractiq.app>   # SERVER ONLY — From header

# -----------------------------------------------------------------------------
# Monitoring / alerting
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STATUS_PAGE_URL=         # Uptime Robot public status page URL — linked from the footer and the incident banner
SLACK_ALERT_WEBHOOK_URL=             # SERVER ONLY — incoming webhook for cost, storage and correction-rate alerts
UPTIME_ROBOT_HEALTH_PATH=/api/health # Endpoint polled by Uptime Robot for the 99.5% uptime SLA
